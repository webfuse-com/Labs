{
  "name": "@webfuse-com/labs",
  "version": "0.2.0",
  "author": "Thassilo M. Schiepanski",
  "type": "module",
  "main": "./dist/api.js",
  "files": [
    "./dist",
    "./prototype-app",
    "./cli.help.txt"
  ],
  "bin": {
    "labs": "./dist/cli/__cli.js",
    "webfuse-labs": "./dist/cli/__cli.js"
  },
  "scripts": {
    "build": "npx esbuild './src/**/*.ts' --outdir=./tmp --bundle --platform=node --packages=external --format=esm --target=es2022",
    "build:watch": "npm run build -- --watch",
    "lint": "npx eslint ./src/*",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "node ./test/test.unit.js",
    "test": "npm run test:unit",
    "cli:bundle": "./labs bundle --stacktrace --working-dir ./example",
    "cli:prototype": "./labs prototype --stacktrace --working-dir ./example",
    "clean": "rm -rf ./tmp && rm -rf ./dist",
    "cycle": "cp -r ./tmp ./dist",
    "bump-version": "node ./scripts/bump-version.js",
    "release": "npm run clean && npm run build && npm run cycle && npm run bump-version"
  },
  "dependencies": {
    "esbuild": "^0.27.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.24.0",
    "eslint-plugin-typescript": "^0.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "typescript-eslint": "^8.30.1"
  }
}
