{
  "name": "@webfuse-com/labs",
  "version": "0.2.0",
  "author": "Thassilo M. Schiepanski",
  "type": "module",
  "main": "./dist/api.js",
  "scripts": {
    "build": "npx esbuild ./src/api/api.ts --bundle --outfile=./dist/api.js --platform=node --packages=external --format=esm --target=es2022",
    "build:watch": "npm run build -- --watch",
    "lint": "npx eslint ./src/*",
    "lint:fix": "npm run lint -- --fix",
    "test:unit": "node --experimental-strip-types ./test/test.unit.js",
    "test": "npm run test:unit"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.24.0",
    "eslint-plugin-typescript": "^0.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "typescript-eslint": "^8.30.1"
  }
}
