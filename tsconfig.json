{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",        
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "rootDir": "./src",
  },
  "include": [
    "./src/**/*.json",
    "./src/**/*.js",
    "./src/**/*.ts"
  ]
}